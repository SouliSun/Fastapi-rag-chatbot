# Groq API configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b

# Embedding and ChromaDB configuration
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
CHROMA_DB_PATH=./chroma_db
COLLECTION_NAME=customer_support_faqs

# Retrieval and Acceptance Thresholds
DEFAULT_TOP_K=3
SIMILARITY_THRESHOLD=0.75
MAX_QUERY_LENGTH=1000

# Generation Parameters
TEMPERATURE=0.2
MAX_COMPLETION_TOKENS=1024
LLM_TIMEOUT_SECONDS=30.0
LLM_MAX_RETRIES=3

# Logging & Privacy
LOG_LEVEL=INFO
LOG_RAW_QUERIES=false

# Conversation Memory (api.py)
MAX_HISTORY_TURNS=5
MAX_ACTIVE_CONVERSATIONS=1000
CONVERSATION_TTL_SECONDS=3600.0

